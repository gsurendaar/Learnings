# ============================================================
#  FT Builder — Environment Configuration
#  Copy this file to .env.local and fill in your values:
#    cp .env.example .env.local
#
#  .env.local is gitignored and will NOT be committed.
# ============================================================

# --- LLM (Anthropic Claude) ---
# Required for FT generation and auto-fix
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4.5

# --- GitHub Enterprise ---
# Required for cloning repos and fetching PR/commit data
GITHUB_TOKEN=ghp_your-pat-here
GITHUB_BASE_URL=https://github.paypal.com
GITHUB_OWNER=Customer-Support-R
GITHUB_REPO=sparkxnodeweb
GITHUB_BRANCH=main

# --- MySQL (for analytics/review tracking) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=qualitydashboard
DB_PORT=3306

# --- App ---
PORT=3211
